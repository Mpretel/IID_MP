        </mxCell>
        <mxCell id="d_legend" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;size=16;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; llave primaria · &lt;b&gt;FK&lt;/b&gt; llave foránea · &lt;b&gt;DD&lt;/b&gt; dimensión degenerada · &lt;b&gt;M&lt;/b&gt; métrica&lt;br&gt;Rojo: hechos · Verde: dimensiones · Violeta: grupo + tabla puente&lt;br&gt;&lt;br&gt;&lt;b&gt;Grano:&lt;/b&gt; una fila por noticia/evento registrado en el OLTP (evento_id), sea de GDELT o propio del medio, en su última actualización. global_event_id se conserva como dimensión degenerada para trazabilidad con GDELT.&lt;br&gt;Todas las dimensiones usan &lt;b&gt;llave sustituta&lt;/b&gt; INT (fecha_key = AAAAMMDD) y un miembro &lt;i&gt;-1 = Desconocido&lt;/i&gt; para actores/ubicaciones vacíos.&lt;br&gt;DIM_TIEMPO y DIM_ACTOR son &lt;b&gt;dimensiones de rol&lt;/b&gt; (role-playing)." vertex="1">
          <mxGeometry height="174" width="460" x="1720" y="80" as="geometry" />
        </mxCell>
        <mxCell id="d_notes" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;size=16;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="&lt;b&gt;Métricas&lt;/b&gt;&lt;br&gt;Aditivas: cantidad_eventos (=1), num_menciones, num_fuentes, num_articulos, tono_x_menciones.&lt;br&gt;No aditivas: tono_promedio, escala_goldstein (se promedian). Tono ponderado = SUM(tono_x_menciones) / SUM(num_menciones).&lt;br&gt;&lt;br&gt;&lt;b&gt;Tabla puente&lt;/b&gt;&lt;br&gt;Cada combinación distinta de códigos CAMEO de un evento es un grupo. factor_ponderacion = 1 / cantidad_categorias evita contar dos veces las métricas al agregar por código.&lt;br&gt;&lt;br&gt;&lt;b&gt;Preguntas de negocio&lt;/b&gt;&lt;br&gt;&lt;b&gt;1. Impacto:&lt;/b&gt; SUM(num_menciones), SUM(num_articulos) por DIM_UBICACION.pais_nombre, DIM_TIEMPO.anio_mes y DIM_CAMEO.&lt;br&gt;&lt;b&gt;2. Sentimiento:&lt;/b&gt; tono ponderado por DIM_ACTOR.categoria_actor (Gobierno, ONG, Empresa…).&lt;br&gt;&lt;b&gt;3. Temporalidad:&lt;/b&gt; SUM(cantidad_eventos) / días distintos por DIM_TIEMPO.tipo_dia (hábil, fin de semana, festivo).&lt;br&gt;&lt;b&gt;4. Multi-temática:&lt;/b&gt; DIM_GRUPO_CATEGORIAS.es_multitematico = TRUE → BRIDGE → DIM_CAMEO." vertex="1">
          <mxGeometry height="320" width="460" x="1720" y="820" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
